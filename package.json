{
  "name": "codex-local-router",
  "version": "0.5.22",
  "description": "Local multi-model routing for Codex CLI and App while preserving ChatGPT subscription access",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyankosama/codex-local-router.git"
  },
  "homepage": "https://github.com/nyankosama/codex-local-router#readme",
  "bugs": "https://github.com/nyankosama/codex-local-router/issues",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src/",
    "scripts/gateway-admin.mjs",
    "scripts/gateway-service.mjs",
    "scripts/codex-app-upgrade.mjs",
    "scripts/run-tests.mjs",
    "scripts/audit-package.mjs",
    "scripts/public-boundary.mjs",
    "scripts/e2e/",
    "test/",
    "!test/cache-affinity-rollout.test.mjs",
    "!test/generic-template-rollout.test.mjs",
    "docs/e2e/thresholds.json",
    "!docs/README.md",
    "config/gateway.example.json",
    "docs/public/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node scripts/run-tests.mjs",
    "gateway": "node scripts/gateway-admin.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "e2e": "node scripts/e2e/run.mjs --group all --include-pre-release",
    "e2e:l0": "node scripts/e2e/run.mjs --group l0",
    "e2e:l1": "node scripts/e2e/run.mjs --group l1",
    "e2e:l2": "node scripts/e2e/run.mjs --group l2",
    "e2e:live": "node scripts/e2e/run.mjs --group live",
    "e2e:focused": "node scripts/e2e/focused-acceptance.mjs",
    "e2e:profiles": "node scripts/e2e/profile-qualification.mjs",
    "e2e:g3": "node scripts/e2e/g3-qualification.mjs",
    "e2e:official-search": "node scripts/e2e/official-search-acceptance.mjs",
    "e2e:third-party-search": "node scripts/e2e/third-party-search-acceptance.mjs",
    "e2e:universal-search": "node scripts/e2e/universal-search-acceptance.mjs",
    "e2e:release": "node scripts/e2e/release-qualification.mjs",
    "e2e:prompt-cache": "node scripts/e2e/prompt-cache-affinity.mjs",
    "e2e:instructions": "node scripts/e2e/instruction-inheritance.mjs",
    "e2e:instructions:live": "node scripts/e2e/instruction-inheritance-live.mjs",
    "e2e:tool-search-history": "node scripts/e2e/tool-search-history-acceptance.mjs",
    "e2e:history-migration": "node scripts/e2e/history-migration-acceptance.mjs",
    "e2e:native-compaction": "node scripts/e2e/native-compaction-acceptance.mjs",
    "e2e:native-continuation-faults": "node scripts/e2e/native-continuation-fault-acceptance.mjs"
  },
  "bin": {
    "codex-local-router": "scripts/gateway-admin.mjs",
    "llm-auto-gateway": "scripts/gateway-admin.mjs"
  },
  "dependencies": {
    "proxy-agent": "8.0.2",
    "proxy-from-env": "2.1.0",
    "ws": "8.21.3"
  }
}
