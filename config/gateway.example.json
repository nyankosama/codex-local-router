{
  "schemaVersion": 4,
  "listen": { "host": "127.0.0.1", "port": 8788 },
  "access": { "required": true, "tokenEnv": "CODEX_LOCAL_ROUTER_TOKEN" },
  "mode": "rules",
  "defaultTarget": "model",
  "providers": {
    "provider": {
      "adapter": "openai-compatible",
      "baseUrl": "https://provider.example/v1",
      "apiKeyEnv": "EXAMPLE_PROVIDER_API_KEY",
      "concurrency": 4
    }
  },
  "targets": {
    "model": {
      "provider": "provider",
      "model": "provider-model-id",
      "modelFamily": "other",
      "wireApi": "responses",
      "contextWindow": 128000,
      "maxContextWindow": 128000,
      "inputModalities": ["text"],
      "compression": { "mode": "unsupported" },
      "capabilities": {
        "responses": true,
        "toolCalling": true,
        "freeformTools": true,
        "streaming": true,
        "nativeWebSearch": false
      },
      "app": {
        "enabled": true,
        "modelId": "provider-model-id",
        "displayName": "Provider model",
        "reasoningLevels": ["low", "medium", "high"],
        "capabilityProfile": "standard-tools",
        "useResponsesLite": false
      },
      "standaloneSearch": { "source": "disabled" }
    }
  },
  "rules": [],
  "pluginTools": {
    "thirdPartyGpt": {
      "additionalAllowedPlugins": [],
      "excludedDefaultPlugins": []
    }
  },
  "standaloneSearch": {
    "thirdPartyGpt": {
      "defaultSource": "subscription"
    }
  },
  "history": {
    "maxBytes": 134217728,
    "ttlMs": 1800000,
    "persistent": {
      "enabled": true,
      "diskMaxBytes": 10737418240,
      "warningPercent": 80
    }
  },
  "timeoutMs": 180000,
  "maxBodyBytes": 20971520,
  "maxConnections": 64,
  "subscription": {
    "enabled": true,
    "catalogPath": "/absolute/path/to/.codex/models_cache.json",
    "models": ["gpt-catalog-placeholder"]
  }
}
